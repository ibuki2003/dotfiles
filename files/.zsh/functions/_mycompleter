_mycompleter() {
  if ! _my_completion_candidates; then
    return 1
  fi

  local pre="$HISTNO$LBUFFER"
  local suf=$RBUFFER

  # A consecutive tab enters the menu after a prefix-only completion inserted
  # its unambiguous part on the first tab.
  if [[ ${_mycompleter_prefix_pending-} == 1 &&
        $LASTWIDGET == expand-or-complete ]]; then
    _mycompleter_prefix_pending=0
    compstate[insert]='automenu'
    return 0
  fi
  _mycompleter_prefix_pending=0

  # Only literal prefix matches may insert their common prefix. Fuzzy matches
  # retain the user's input because their literal common part is meaningless.
  if [[ $pre != "${_mycompleter_prefix-}" || $suf != "${_mycompleter_suffix-}" ]]; then
    _mycompleter_prefix=$pre
    _mycompleter_suffix=$suf

    if (( compstate[nmatches] != 1 )); then
      if [[ ${_fuzzy_path_prefix_match-} == prefix ]]; then
        compstate[insert]='unambiguous'
        _mycompleter_prefix_pending=1
      else
        compstate[insert]=''
      fi
      compstate[list]='list force'
    else
      compstate[insert]='unambiguous'
    fi
  else
    compstate[insert]='automenu'
  fi

  return 0
}

