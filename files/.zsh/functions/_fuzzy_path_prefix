[[ $PREFIX == */* ]] || return 1
[[ $PREFIX != '~'* || $PREFIX == '~/'* ]] || return 1

local input_path=$PREFIX
local component pattern char candidate base search_base unresolved
local fuzzy_pattern
local -a components bases next matches
local -a step_matches filtered_steps
local -a deep_expl step_expl
local -a compadd_prefix
local -A deep_seen
local -a exact_matches prefix_matches fuzzy_matches
local -i index last transformed=0 home_relative=0

if [[ $input_path == '~/'* ]]; then
  input_path=${input_path#\~/}
  bases=($HOME)
  compadd_prefix=(-p '~/')
  home_relative=1
elif [[ $input_path == /* ]]; then
  input_path=${input_path#/}
  bases=(/)
else
  bases=('')
fi
components=("${(@s:/:)input_path}")
last=$#components

for (( index = 1; index <= last; ++index )); do
  component=$components[index]
  next=()
  exact_matches=()
  prefix_matches=()
  fuzzy_matches=()

  pattern="(#i)${(b)component}*"
  fuzzy_pattern='(#i)'
  for char in ${(s::)component}; do
    fuzzy_pattern+="*${(b)char}"
  done
  fuzzy_pattern+='*'

  for base in "${bases[@]}"; do
    search_base=$base
    [[ -z $search_base || $search_base == / ]] || search_base+=/

    if [[ -e $search_base$component ]]; then
      if (( index == last )) || [[ -d $search_base$component ]]; then
        exact_matches+=($search_base$component)
      fi
      continue
    fi

    # Let globbing discard non-prefix entries before they reach a Zsh array.
    if (( index == last )); then
      prefix_matches+=("$search_base"${~pattern}(N))
    else
      prefix_matches+=("$search_base"${~pattern}(N-/))
    fi
  done

  # A second full listing is intentionally limited to the fuzzy fallback.
  if (( $#exact_matches == 0 && $#prefix_matches == 0 )); then
    for base in "${bases[@]}"; do
      search_base=$base
      [[ -z $search_base || $search_base == / ]] || search_base+=/

      if (( index == last )); then
        if [[ $component == .* ]]; then
          fuzzy_matches+=("$search_base"${~fuzzy_pattern}(ND))
        else
          fuzzy_matches+=("$search_base"${~fuzzy_pattern}(N))
        fi
      else
        if [[ $component == .* ]]; then
          fuzzy_matches+=("$search_base"${~fuzzy_pattern}(ND-/))
        else
          fuzzy_matches+=("$search_base"${~fuzzy_pattern}(N-/))
        fi
      fi
    done
  fi

  if (( $#exact_matches )); then
    next=("${exact_matches[@]}")
  elif (( $#prefix_matches )); then
    next=("${prefix_matches[@]}")
    if (( transformed == 0 && index < last )); then
      unresolved=${(j:/:)components[index + 1,-1]}
      for candidate in "${next[@]}"; do
        step_matches+=("${candidate%/}/$unresolved")
      done
    fi
    transformed=1
  elif (( $#fuzzy_matches )); then
    next=("${fuzzy_matches[@]}")
    if (( transformed == 0 && index < last )); then
      unresolved=${(j:/:)components[index + 1,-1]}
      for candidate in "${next[@]}"; do
        step_matches+=("${candidate%/}/$unresolved")
      done
    fi
    transformed=1
  fi

  if (( $#next == 0 )); then
    if (( transformed == 0 )); then
      # Tell the candidate router that this path was rejected by the selected
      # policy, so a later completer cannot reintroduce a partial expansion.
      return 2
    fi
    unresolved=${(j:/:)components[index,-1]}
    matches=()
    for base in "${bases[@]}"; do
      matches+=("${base%/}/$unresolved")
    done
    deep_seen=()
    filtered_steps=()
    for candidate in "${matches[@]}"; do
      deep_seen[$candidate]=1
    done
    for candidate in "${step_matches[@]}"; do
      [[ -n ${deep_seen[$candidate]-} ]] || filtered_steps+=($candidate)
    done
    if (( home_relative )); then
      matches=("${(@)matches#$HOME/}")
      filtered_steps=("${(@)filtered_steps#$HOME/}")
    fi
    _description -V deep-paths deep_expl filename
    compadd -QUf "$deep_expl[@]" -W '' "$compadd_prefix[@]" -a matches
    if (( $#filtered_steps )); then
      _description -V step-paths step_expl filename
      compadd -QUf "$step_expl[@]" -W '' "$compadd_prefix[@]" -a filtered_steps
    fi
    return
  fi

  bases=("${next[@]}")
done

(( transformed )) || return 1
deep_seen=()
filtered_steps=()
for candidate in "${bases[@]}"; do
  deep_seen[$candidate]=1
done
for candidate in "${step_matches[@]}"; do
  [[ -n ${deep_seen[$candidate]-} ]] || filtered_steps+=($candidate)
done
if (( home_relative )); then
  bases=("${(@)bases#$HOME/}")
  filtered_steps=("${(@)filtered_steps#$HOME/}")
fi
_description -V deep-paths deep_expl filename
compadd -QUf "$deep_expl[@]" -W '' "$compadd_prefix[@]" -a bases
if (( $#filtered_steps )); then
  _description -V step-paths step_expl filename
  compadd -QUf "$step_expl[@]" -W '' "$compadd_prefix[@]" -a filtered_steps
fi
return

